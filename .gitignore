# Local Claude Code settings (machine-specific permissions)
.claude/settings.local.json

# OS noise
.DS_Store
Thumbs.db

# Round data NEVER goes in this repo.
#
# Pages serves it, so the repo is public, and a dense track is a location
# history - his course, his office, his house. The filename pattern below was
# the whole guard until 2026-09-10, when exports were renamed to say what was
# in them (2026-09-09_FT6_veenker_...) and stopped matching it. `git add -A`
# then staged four of them. Ignore the DIRECTORY, so the guard does not depend
# on what anyone happens to call a file.
docs/roundDownloads/
golf-tracker-*.json
*-export-*.json

# Native Android builds under android/: build output, Gradle and Kotlin state,
# machine-specific SDK paths, IDE files.
#
# The shell (android/tracker/) copies the web build into its APK assets at build
# time; that copy lands under app/build/generated/webAssets and is NEVER
# committed - the files at the repo root are the one source of truth.
android/**/build/
android/tracker/app/build/generated/webAssets/
android/**/.gradle/
android/**/.kotlin/
android/**/local.properties
android/**/.idea/
android/**/*.iml

# Photos of the old Veenker yardage book - a free handout, since discontinued -
# kept locally as a course reference. Not for a public repo.
docs/Veenker/
